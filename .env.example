# Copy to .env and edit. Every value is optional.
PORT=3000

# Serve the website from this same server (default: ../site). Set empty to run the API only.
# STATIC_DIR=../site

# Websites allowed to call the API from another domain, comma separated. Leave empty for same-origin only.
# ALLOWED_ORIGINS=https://www.zavexcode.com,https://zavexcode.com

# Set to true when running behind a proxy/host that sets X-Forwarded-For (Render, Railway, Nginx, Cloudflare)
TRUST_PROXY=false

# Spam protection: max submissions per IP per window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=10

# Email notification through Resend (https://resend.com). Leave RESEND_API_KEY empty to skip email.
RESEND_API_KEY=
MAIL_TO=zavexcode@gmail.com
MAIL_FROM=ZavexCode <onboarding@resend.dev>

# Where plain HTML form posts are sent after success
SUCCESS_REDIRECT=/thanks.html
